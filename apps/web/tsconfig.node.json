{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "types": ["node"]
  },
  // appVersion.ts はバージョン表記の組み立て規則 (#248)。vite.config.ts が
  // ビルド時に呼ぶため、ビルド設定側のプロジェクトにも含める。
  "include": ["vite.config.ts", "vitest.config.ts", "src/lib/appVersion.ts"]
}
