// =============================================================================
// TRAKON — Prisma Schema
// -----------------------------------------------------------------------------
// 詳細: docs/design/02-database.md
// Sub-Phase 0.1: users / oauth_identities / audit_logs を追加
// -----------------------------------------------------------------------------
// 設計書方針:
//   * 主キーは UUID v7 (Prisma 5.14+ の `@default(uuid(7))`)
//   * ENUM は Postgres `text + CHECK 制約` で実体化 (Postgres native enum は不採用)
//     → Prisma 上は String、許容値はマイグレーション SQL の CHECK 制約で強制
//   * `updated_at` は DB トリガで自動更新 (Prisma `@updatedAt` は使わない)
//   * `audit_logs` は append-only (UPDATE / DELETE をトリガで拒否)
// =============================================================================

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// -----------------------------------------------------------------------------
// users — アプリ側のユーザー本体 (Supabase auth.users と 1:1)
// 設計書 §2.4.1
// -----------------------------------------------------------------------------
model User {
  id                String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  authUserId        String    @unique(map: "uq_users_auth_user_id") @map("auth_user_id") @db.Uuid
  email             String    @unique(map: "uq_users_email")
  fullName          String    @map("full_name")
  displayName       String    @map("display_name")
  /// 'password' | 'google' | 'microsoft' (CHECK 制約)
  primaryAuthMethod String    @default("password") @map("primary_auth_method")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz

  oauthIdentities OAuthIdentity[]
  auditLogs       AuditLog[]
  projectsCreated Project[]       @relation("ProjectsCreatedBy")
  memberships     ProjectMember[]

  @@index([authUserId], map: "idx_users_auth_user_id")
  @@map("users")
}

// -----------------------------------------------------------------------------
// projects — プロジェクト本体
// 設計書 §2.4.2
// -----------------------------------------------------------------------------
model Project {
  id             String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String?   @map("organization_id") @db.Uuid
  name           String
  startDate      DateTime  @map("start_date") @db.Date
  endDate        DateTime  @map("end_date") @db.Date
  /// 'active' | 'closed' (CHECK 制約)
  status         String    @default("active")
  createdBy      String    @map("created_by") @db.Uuid
  closedAt       DateTime? @map("closed_at") @db.Timestamptz
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  creator     User            @relation("ProjectsCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict, map: "fk_projects_created_by")
  members     ProjectMember[]
  items       ProjectItem[]
  invitations Invitation[]

  @@index([organizationId], map: "idx_projects_organization_id")
  @@index([createdBy, status], map: "idx_projects_created_by_status")
  @@map("projects")
}

// -----------------------------------------------------------------------------
// project_members — プロジェクト参加者 (招待中は user_id NULL)
// 設計書 §2.4.3
// -----------------------------------------------------------------------------
model ProjectMember {
  id               String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  projectId        String    @map("project_id") @db.Uuid
  /// 招待受諾前は NULL
  userId           String?   @map("user_id") @db.Uuid
  name             String
  email            String
  organizationName String    @map("organization_name")
  /// 'client' | 'production' (CHECK 制約)
  memberType       String    @map("member_type")
  /// Phase 1+ で権限細分化に使用
  roleType         String?   @map("role_type")
  sortOrder        Int       @default(0) @map("sort_order")
  isActive         Boolean   @default(true) @map("is_active")
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade, map: "fk_pm_project_id")
  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull, map: "fk_pm_user_id")
  invitations Invitation[]

  @@unique([projectId, email], map: "uq_pm_project_email")
  @@index([projectId, sortOrder], map: "idx_pm_project_sort")
  @@index([userId], map: "idx_pm_user_id")
  @@map("project_members")
}

// -----------------------------------------------------------------------------
// project_items — 制作物
// 設計書 §2.4.4
// -----------------------------------------------------------------------------
model ProjectItem {
  id        String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  projectId String    @map("project_id") @db.Uuid
  name      String
  /// Phase 1+ (page|document|banner|other)
  itemType  String?   @map("item_type")
  sortOrder Int       @default(0) @map("sort_order")
  startDate DateTime? @map("start_date") @db.Date
  endDate   DateTime? @map("end_date") @db.Date
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade, map: "fk_pi_project_id")

  @@index([projectId, sortOrder], map: "idx_pi_project_sort")
  @@map("project_items")
}

// -----------------------------------------------------------------------------
// invitations — プロジェクト招待トークン (自前管理)
// 設計書 §2.4.8
// -----------------------------------------------------------------------------
model Invitation {
  id              String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  projectId       String    @map("project_id") @db.Uuid
  invitedMemberId String    @map("invited_member_id") @db.Uuid
  email           String
  /// SHA-256 ハッシュ。生トークンは保存しない
  tokenHash       String    @unique(map: "uq_inv_token_hash") @map("token_hash")
  roleType        String?   @map("role_type")
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz
  acceptedAt      DateTime? @map("accepted_at") @db.Timestamptz
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz

  project       Project       @relation(fields: [projectId], references: [id], onDelete: Cascade, map: "fk_inv_project_id")
  invitedMember ProjectMember @relation(fields: [invitedMemberId], references: [id], onDelete: Cascade, map: "fk_inv_invited_member_id")

  @@index([projectId], map: "idx_inv_project_id")
  @@map("invitations")
}

// -----------------------------------------------------------------------------
// oauth_identities — OAuth 連携 (v1.1, Phase 0)
// 設計書 §2.4.X
// -----------------------------------------------------------------------------
model OAuthIdentity {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  /// 'google' | 'microsoft' (CHECK 制約)
  provider       String
  providerUserId String   @map("provider_user_id")
  email          String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, map: "fk_oauth_identities_user_id")

  @@unique([provider, providerUserId], map: "uq_oauth_identities_provider_provider_user_id")
  @@unique([userId, provider], map: "uq_oauth_identities_user_id_provider")
  @@index([userId], map: "idx_oauth_identities_user_id")
  @@map("oauth_identities")
}

// -----------------------------------------------------------------------------
// audit_logs — 監査ログ (append-only)
// 設計書 §2.4.7
// -----------------------------------------------------------------------------
model AuditLog {
  id           String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  occurredAt   DateTime @default(now()) @map("occurred_at") @db.Timestamptz
  actorUserId  String?  @map("actor_user_id") @db.Uuid
  /// share_links FK は Sub-Phase 0.5 で実装 (share_links テーブル追加時)
  shareLinkId  String?  @map("share_link_id") @db.Uuid
  /// Phase 0 許可値: login | logout | toss | complete | share_access | share_create | share_revoke | share_toss | share_complete
  action       String
  resourceType String   @map("resource_type")
  resourceId   String?  @map("resource_id") @db.Uuid
  /// 'success' | 'failure' (CHECK 制約)
  result       String
  ip           String?  @db.Inet
  userAgent    String?  @map("user_agent")
  extra        Json     @default("{}")

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull, map: "fk_al_actor_user_id")

  @@index([occurredAt(sort: Desc)], map: "idx_al_occurred_at_desc")
  @@index([actorUserId, occurredAt(sort: Desc)], map: "idx_al_actor_user_id_occurred_at")
  @@index([resourceType, resourceId], map: "idx_al_resource")
  @@map("audit_logs")
}
