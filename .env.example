# =============================================================================
# TRAKON — 環境変数テンプレート
# =============================================================================
# 実値はローカル: apps/web/.env.local（gitignore）
# 本番/プレビュー: Vercel Environment Variables
# Supabase 接続キーは Supabase Vault 推奨
# =============================================================================

# --- App ---
NODE_ENV=development
APP_ENV=local
PUBLIC_APP_URL=http://localhost:5173

# --- Server (Hono on Node) ---
SERVER_PORT=3001

# --- Supabase ---
# Local: supabase start で出力される値を貼る
# Prod : Supabase Dashboard → Settings → API より取得
# 新方式 API キー（推奨, sb_publishable_* / sb_secret_*）を使用。
# Legacy API keys（anon / service_role JWT）は 2026 年末でサポート終了予定。
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SECRET_KEY=
# 旧名 SUPABASE_SERVICE_ROLE_KEY は deprecated。BE は後方互換あり
# (SUPABASE_SECRET_KEY が未設定なら SUPABASE_SERVICE_ROLE_KEY にフォールバック)
# SUPABASE_SERVICE_ROLE_KEY=

# FE 側で参照する公開キー (Vite は VITE_ プレフィックスのみ公開)
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_API_BASE_URL=/api/v1

# --- Database (Prisma) ---
# app_user / app_migrator のロール分離は Sub-Phase 0.6 で導入
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres?schema=public
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres?schema=public

# --- Resend (Sub-Phase 0.2 〜) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- Sentry (Sub-Phase 0.6) ---
SENTRY_DSN=
VITE_SENTRY_DSN=
SENTRY_ENVIRONMENT=local

# --- OAuth (Sub-Phase 0.1 後半) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Stripe (Phase 0.5 有料プラン)
# 設計書 docs/design/06-infrastructure.md §6.5.3 / 07-billing.md §7.3.3
#
# テストモードと本番モードで ID はすべて別値になる。テストで本番 ID を流用しない。
# Secret Key / Webhook Secret は Vercel の環境変数へ直接登録し、
# 文書・チャット・スクリーンショットに残さない (PRD SR-BILL-04)。
#
# クライアント公開鍵は不要 (ホスト型 Checkout へサーバーサイドでリダイレクトするだけで、
# ブラウザ側で Stripe SDK を動かさないため)。
#
# 初回セットアップ手順は docs/operations.md の Runbook を参照。
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PERSONAL_MONTHLY_PRICE_ID=
STRIPE_TEAM_MONTHLY_PRICE_ID=
STRIPE_JP_TAX_RATE_ID=
# Customer Portal の構成 ID。プラン変更を無効化した構成を明示指定する
STRIPE_PORTAL_CONFIGURATION_ID=
