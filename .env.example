# =============================================================================
# TRAKON — 環境変数テンプレート
# =============================================================================
# 実値はローカル: apps/web/.env.local（gitignore）
# 本番/プレビュー: Vercel Environment Variables
# Supabase 接続キーは Supabase Vault 推奨
# =============================================================================

# --- App ---
NODE_ENV=development
APP_ENV=local
PUBLIC_APP_URL=http://localhost:5173

# --- Server (Hono on Node) ---
SERVER_PORT=3001

# --- Supabase ---
# Local: supabase start で出力される値を貼る
# Prod : Supabase Dashboard より取得
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# FE 側で参照する公開キー (Vite は VITE_ プレフィックスのみ公開)
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
VITE_API_BASE_URL=/api/v1

# --- Database (Prisma) ---
# app_user / app_migrator のロール分離は Sub-Phase 0.6 で導入
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres?schema=public
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres?schema=public

# --- Resend (Sub-Phase 0.2 〜) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- Sentry (Sub-Phase 0.6) ---
SENTRY_DSN=
VITE_SENTRY_DSN=
SENTRY_ENVIRONMENT=local

# --- OAuth (Sub-Phase 0.1 後半) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
